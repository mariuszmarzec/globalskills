#!/usr/bin/env bash
# aicode - Start AI dev environment and launch OpenCode

# PATH and shell-wide tool configuration come from the operator's ~/.zshrc.
# Do not maintain a second PATH list in this launcher.
unset TODO_LOCAL_MCP_TOKEN

# Dedicated service env files are compatibility fallbacks only. Values already
# exported by the operator's Zsh session win and PATH is never loaded from them.
load_environment_fallback() {
    local env_file="$1"
    [ -f "$env_file" ] || return 0
    if ! bash -n "$env_file" >/dev/null 2>&1; then
        echo "WARNING: ignoring invalid environment fallback: $env_file" >&2
        return 0
    fi
    set -a
    # shellcheck disable=SC1090
    . <(awk '
        BEGIN {
            for (name in ENVIRON) inherited[name] = 1
        }
        {
            candidate = $0
            sub(/^[[:space:]]*/, "", candidate)
            sub(/^export[[:space:]]+/, "", candidate)
            name = ""
            if (match(candidate, /^[A-Za-z_][A-Za-z0-9_]*=/)) {
                name = substr(candidate, 1, index(candidate, "=") - 1)
            }
            if (name == "PATH" || (name != "" && name in inherited)) next
            print
        }
    ' "$env_file")
    set +a
}

# Resolve symlinks using POSIX tools (macOS readlink has no -f option).
AICODE_SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$AICODE_SOURCE_PATH" ]; do
    AICODE_SOURCE_PARENT="$(cd -P "$(dirname "$AICODE_SOURCE_PATH")" && pwd)"
    AICODE_SOURCE_TARGET="$(readlink "$AICODE_SOURCE_PATH")"
    case "$AICODE_SOURCE_TARGET" in
        /*) AICODE_SOURCE_PATH="$AICODE_SOURCE_TARGET" ;;
        *)  AICODE_SOURCE_PATH="$AICODE_SOURCE_PARENT/$AICODE_SOURCE_TARGET" ;;
    esac
done
AICODE_SOURCE_DIR="$(cd -P "$(dirname "$AICODE_SOURCE_PATH")" && pwd)"
AICODE_SOURCE_PATH="$AICODE_SOURCE_DIR/$(basename "$AICODE_SOURCE_PATH")"

MANUL_CANONICAL_DIR="${MANUL_CANONICAL_DIR:-$HOME/.manul-repo/skills/manul-github-bot}"
MANUL_CANONICAL_ROOT="${MANUL_CANONICAL_ROOT:-$HOME/.manul-repo}"
MANUL_CANONICAL_BRANCH="${MANUL_CANONICAL_BRANCH:-master}"
MANUL_HOST_SKILLS_DIR="${MANUL_HOST_SKILLS_DIR:-$HOME/.agents/skills}"
export MANUL_CANONICAL_DIR MANUL_CANONICAL_ROOT MANUL_CANONICAL_BRANCH MANUL_HOST_SKILLS_DIR

MANUL_PLATFORM_HELPER="$MANUL_CANONICAL_DIR/manul-platform.sh"
if [ -r "$MANUL_PLATFORM_HELPER" ]; then
    # shellcheck source=~/.manul-repo/skills/manul-github-bot/manul-platform.sh
    . "$MANUL_PLATFORM_HELPER"
    manul_platform_prepare || exit 1
    manul_platform_reexec_if_needed "$AICODE_SOURCE_PATH" "$@"
elif [ "$(uname -s 2>/dev/null)" = "Darwin" ]; then
    echo "ERROR: Manul platform helper is missing: $MANUL_PLATFORM_HELPER" >&2
    exit 1
fi

# Todo transport and endpoint discovery are owned by standalone Manul. Aicode
# supplies only the optional WSL/Windows bridge lifecycle; native hosts use the
# same Manul resolver without installing globalskills-specific MCP helpers.
TODO_LOCAL_MCP_URL_HELPER="$MANUL_CANONICAL_DIR/todo-local-mcp-url.sh"
TODO_MCP_CLIENT="${TODO_MCP_CLIENT:-$MANUL_CANONICAL_DIR/todo-mcp-client.py}"
export TODO_MCP_CLIENT TODO_LOCAL_MCP_URL_HELPER
if [ -r "$TODO_LOCAL_MCP_URL_HELPER" ]; then
    # shellcheck source=aicode/todo-local-mcp-url.sh
    . "$TODO_LOCAL_MCP_URL_HELPER"
else
    echo "WARNING: Manul Todo MCP endpoint resolver is missing at $TODO_LOCAL_MCP_URL_HELPER; local Todo polling will report an error." >&2
fi

load_environment_fallback "$HOME/.config/opencode/opencode.env"
unset TODO_LOCAL_MCP_TOKEN

# Resolve Manul's automatic agent runtime before touching OpenClaw. Use the
# same config/env precedence as Manul itself; selecting OpenCode means this
# launcher must not start, query, or configure an OpenClaw Gateway.
MANUL_RUNTIME_DIR="${MANUL_RUNTIME_DIR:-$HOME/.manul}"
MANUL_DIR="${MANUL_DIR:-$MANUL_RUNTIME_DIR}"
export MANUL_DIR
MANUL_PATHS_HELPER="$MANUL_CANONICAL_DIR/manul-paths.sh"
if [ ! -r "$MANUL_PATHS_HELPER" ]; then
    echo "ERROR: Manul runtime selector is missing: $MANUL_PATHS_HELPER" >&2
    exit 1
fi
# shellcheck source=~/.manul-repo/skills/manul-github-bot/manul-paths.sh
. "$MANUL_PATHS_HELPER"

OPENCLAW_SNAPSHOT_HELPER="$AICODE_SOURCE_DIR/openclaw-config-snapshot.sh"
if [ "$AGENT_RUNTIME" = "openclaw" ]; then
    if [ ! -r "$OPENCLAW_SNAPSHOT_HELPER" ]; then
        echo "ERROR: OpenClaw config snapshot helper is missing: $OPENCLAW_SNAPSHOT_HELPER" >&2
        exit 1
    fi
    # shellcheck source=aicode/openclaw-config-snapshot.sh
    . "$OPENCLAW_SNAPSHOT_HELPER"
else
    echo "Manul agentRuntime=$AGENT_RUNTIME; skipping OpenClaw Gateway and ACPX setup."
fi

# Start Ollama first. LiteLLM and Caracal may use local models, so wait
# for the HTTP API rather than treating an existing process as ready.
OLLAMA_BASE_URL="${OLLAMA_BASE_URL:-http://127.0.0.1:11434}"
OLLAMA_READY_TIMEOUT="${OLLAMA_READY_TIMEOUT:-45}"

ollama_http_ready() {
    curl --noproxy '*' -fsS --connect-timeout 1 --max-time 2 \
        "${OLLAMA_BASE_URL%/}/api/tags" >/dev/null 2>&1
}

if ! ollama_http_ready; then
    if ! pgrep -x "ollama" >/dev/null; then
        echo "Starting Ollama..."
        nohup ollama serve >/tmp/ollama.log 2>&1 &
    fi

    if ! [[ "$OLLAMA_READY_TIMEOUT" =~ ^[0-9]{1,3}$ ]] ||
       (( OLLAMA_READY_TIMEOUT < 1 || OLLAMA_READY_TIMEOUT > 300 )); then
        OLLAMA_READY_TIMEOUT=45
    fi
    echo "Waiting for Ollama API at ${OLLAMA_BASE_URL} (timeout ${OLLAMA_READY_TIMEOUT}s)..."
    ollama_ready=0
    for ((ollama_second = 0; ollama_second < OLLAMA_READY_TIMEOUT; ollama_second++)); do
        if ollama_http_ready; then
            ollama_ready=1
            break
        fi
        sleep 1
    done
    if [ "$ollama_ready" -ne 1 ]; then
        echo "ERROR: Ollama API did not become ready at ${OLLAMA_BASE_URL}; see /tmp/ollama.log." >&2
        exit 1
    fi
fi
echo "Ollama API is ready at ${OLLAMA_BASE_URL}."

# Ensure PostgreSQL is available for LiteLLM UI/auth
if command -v pg_isready >/dev/null 2>&1; then
    if ! pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1; then
        if command -v service >/dev/null 2>&1; then
            sudo -n service postgresql start >/dev/null 2>&1 || true
        fi
        if command -v pg_ctlcluster >/dev/null 2>&1; then
            sudo -n pg_ctlcluster 12 main start >/dev/null 2>&1 || true
        fi
        sleep 3
    fi

    if pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1; then
        if ! sudo -n -u postgres psql -Atqc \
            "SELECT 1 FROM pg_roles WHERE rolname='litellm'" 2>/dev/null | grep -qx '1'; then
            echo "Creating PostgreSQL user/database for LiteLLM..."
            sudo -n -u postgres psql \
                -c "CREATE USER litellm WITH PASSWORD 'litellm';" \
                >/dev/null 2>&1 || true
            sudo -n -u postgres psql \
                -c "CREATE DATABASE litellm OWNER litellm;" \
                >/dev/null 2>&1 || true
        fi
    fi
fi

# Ensure LiteLLM is running
if ! pgrep -f '[l]itellm' >/dev/null; then
    load_environment_fallback "$HOME/litellm/.env"
    echo "Starting LiteLLM..."
    if [ -x /home/marzec/.local/bin/litellm ]; then
        nohup python3.12 /home/marzec/.local/bin/litellm \
            --config "$HOME/litellm/config.yaml" \
            --port 4000 \
            >/tmp/litellm.log 2>&1 &
    else
        nohup litellm \
            --config "$HOME/litellm/config.yaml" \
            --port 4000 \
            >/tmp/litellm.log 2>&1 &
    fi
    sleep 3
fi


# Start Caracal RAG after LiteLLM. Only attach credentials to a service that
# this launcher verifies it owns; never kill processes by a fuzzy name.
CARACAL_HOME="${CARACAL_HOME:-$HOME/.caracal}"
export CARACAL_HOME
CARACAL_CLI="$CARACAL_HOME/bin/caracal-rag"
CARACAL_RUN_DIR="$CARACAL_HOME/run"
CARACAL_PID_FILE="$CARACAL_RUN_DIR/mcp.pid"
CARACAL_LOG="/tmp/caracal-mcp.log"

caracal_http_ready() {
    local url="$1" status
    status="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 2 "$url" 2>/dev/null || true)"
    [[ "$status" =~ ^[1-4][0-9][0-9]$ ]]
}

caracal_pid_matches() {
    local pid="$1" command_line
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    command_line="$(ps -p "$pid" -o args= 2>/dev/null || true)"
    [[ "$command_line" == *"caracal-rag mcp --transport http"* &&
       "$command_line" == *"--port $CARACAL_MCP_PORT"* &&
       "$command_line" == *"--path $CARACAL_MCP_PATH"* ]]
}

# Load the Caracal token and configured URL from its single provider.
# Ignore inherited values first, then let ~/.caracal/env.sh provide the
# operator's configured endpoint. The MCP launch itself does not wait for
# embedding readiness; Caracal can finish warming up while Manul/OpenCode start.
unset CARACAL_MCP_URL CARACAL_ACCESS_TOKEN
if [ -r "$CARACAL_HOME/env.sh" ]; then
    # shellcheck source=~/.caracal/env.sh
    . "$CARACAL_HOME/env.sh"
else
    echo "WARNING: Caracal environment provider is missing: $CARACAL_HOME/env.sh" >&2
fi
ensure_caracal_mcp() {
    # Caracal startup is deliberately non-blocking. The embedding provider may
    # still be warming up; that must not delay Manul or OpenCode startup.
    if [ -z "${CARACAL_ACCESS_TOKEN:-}" ]; then
        echo "WARNING: Caracal access token is unavailable; continuing without Caracal MCP." >&2
        return 0
    fi
    if [ ! -x "$CARACAL_CLI" ]; then
        echo "WARNING: Caracal CLI is not executable at $CARACAL_CLI; continuing without Caracal MCP." >&2
        return 0
    fi

    local configured_url mcp_host mcp_port mcp_port_number mcp_path mcp_url
    configured_url="${CARACAL_MCP_URL:-http://127.0.0.1:3500/mcp}"
    if [[ "$configured_url" =~ ^http://(127\.0\.0\.1):([0-9]{1,5})(/[A-Za-z0-9/_-]+)$ ]]; then
        mcp_host="${BASH_REMATCH[1]}"
        mcp_port="${BASH_REMATCH[2]}"
        mcp_path="${BASH_REMATCH[3]}"
    else
        echo "WARNING: Caracal MCP URL must be a loopback HTTP URL; refusing to launch it: $configured_url" >&2
        return 0
    fi
    mcp_port_number=$((10#$mcp_port))
    if (( mcp_port_number < 1 || mcp_port_number > 65535 )); then
        echo "WARNING: Caracal MCP port is invalid ($mcp_port); continuing without Caracal MCP." >&2
        return 0
    fi
    mcp_port="$mcp_port_number"

    CARACAL_MCP_HOST="$mcp_host"
    CARACAL_MCP_PORT="$mcp_port"
    CARACAL_MCP_PATH="$mcp_path"
    mcp_url="http://$mcp_host:$mcp_port$mcp_path"

    if [ -L "$CARACAL_RUN_DIR" ] || [ -L "$CARACAL_PID_FILE" ]; then
        echo "WARNING: refusing symlinked Caracal runtime/PID path; inspect $CARACAL_RUN_DIR. Continuing without Caracal MCP." >&2
        return 0
    fi
    if ! mkdir -p "$CARACAL_RUN_DIR"; then
        echo "WARNING: unable to create Caracal runtime directory $CARACAL_RUN_DIR; continuing without Caracal MCP." >&2
        return 0
    fi
    chmod 0700 "$CARACAL_RUN_DIR" || {
        echo "WARNING: unable to protect Caracal runtime directory; continuing without Caracal MCP." >&2
        return 0
    }

    if [ -e "$CARACAL_PID_FILE" ]; then
        if [ ! -f "$CARACAL_PID_FILE" ]; then
            echo "WARNING: unexpected Caracal PID path: $CARACAL_PID_FILE; continuing without Caracal MCP." >&2
            return 0
        fi
        local old_pid
        IFS= read -r old_pid < "$CARACAL_PID_FILE" || old_pid=""
        if caracal_pid_matches "$old_pid"; then
            export CARACAL_MCP_URL="$mcp_url"
            if caracal_http_ready "$mcp_url"; then
                echo "Caracal MCP already running at $mcp_url (PID $old_pid)."
            else
                echo "Caracal MCP process is already starting at $mcp_url (PID $old_pid); continuing without waiting."
            fi
            return 0
        fi
        # Never kill an unverified process whose PID may have been reused.
        rm -f -- "$CARACAL_PID_FILE"
    fi

    if caracal_http_ready "$mcp_url"; then
        echo "WARNING: $mcp_url responds but is not owned by a valid Caracal PID file; refusing to attach credentials. Continuing without Caracal MCP." >&2
        return 0
    fi

    umask 077
    if ! touch "$CARACAL_LOG"; then
        echo "WARNING: unable to create Caracal log $CARACAL_LOG; continuing without Caracal MCP." >&2
        umask 022
        return 0
    fi
    chmod 0600 "$CARACAL_LOG"
    echo "Starting Caracal MCP at $mcp_url (non-blocking)..."
    nohup "$CARACAL_CLI" mcp --transport http --host "$mcp_host" --port "$mcp_port" --path "$mcp_path" \
        </dev/null >>"$CARACAL_LOG" 2>&1 &
    local caracal_pid=$!
    if ! printf '%s\n' "$caracal_pid" > "$CARACAL_PID_FILE"; then
        echo "WARNING: unable to record Caracal MCP PID; inspect $CARACAL_LOG. Continuing startup." >&2
        umask 022
        return 0
    fi
    chmod 0600 "$CARACAL_PID_FILE"
    umask 022

    export CARACAL_MCP_URL="$mcp_url"
    echo "Caracal MCP launch requested at $mcp_url (PID $caracal_pid); continuing without readiness wait."
    return 0
}

ensure_todo_mcp_bridge() {
    export TODO_LOCAL_MCP_AVAILABLE=0 TODO_LOCAL_MCP_CONNECTED=0
    unset TODO_LOCAL_MCP_URL

    if ! command -v python3 >/dev/null 2>&1 ||
       ! declare -F todo_local_mcp_is_wsl >/dev/null 2>&1 ||
       ! declare -F todo_local_mcp_probe_status >/dev/null 2>&1; then
        echo "WARNING: Todo MCP endpoint discovery prerequisites are missing; Todo MCP is disabled for this launch." >&2
        return 0
    fi

    local direct_url="http://127.0.0.1:8765/mcp"
    local direct_status
    direct_status="$(todo_local_mcp_probe_status "$direct_url")"
    if [ "$direct_status" = "200" ]; then
        export TODO_LOCAL_MCP_URL="$direct_url"
        export TODO_LOCAL_MCP_AVAILABLE=1 TODO_LOCAL_MCP_CONNECTED=1
        echo "Todo MCP initialize and tools/list handshake succeeded at $TODO_LOCAL_MCP_URL."
        return 0
    fi

    # Only WSL needs the Windows host bridge. Native Linux/macOS connects to
    # Todo Desktop's loopback listener and never invokes PowerShell or wslpath.
    if ! todo_local_mcp_is_wsl; then
        echo "WARNING: Todo Desktop MCP did not complete an unauthenticated initialize/tools/list handshake at $direct_url (probe status $direct_status); Todo MCP is disabled for this launch." >&2
        echo "Check that Todo Desktop is running, todo.localMcpServer is enabled, and a user session is active." >&2
        return 0
    fi

    if ! command -v powershell.exe >/dev/null 2>&1 || ! command -v wslpath >/dev/null 2>&1 ||
       ! command -v ip >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
        echo "WARNING: WSL/Windows bridge prerequisites are missing; Todo MCP is disabled for this launch." >&2
        return 0
    fi

    local windows_host_ip wsl_client_ip windows_script
    windows_host_ip="$(ip -4 route show default 2>/dev/null | awk '$1 == "default" { for (i = 1; i <= NF; i++) if ($i == "via") { print $(i + 1); exit } }')"
    if ! [[ "$windows_host_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        echo "WARNING: unable to resolve the WSL default-route Windows host IP; Todo MCP is disabled for this launch." >&2
        return 0
    fi
    wsl_client_ip="$(ip -4 route get "$windows_host_ip" 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit } }')"
    if ! [[ "$wsl_client_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        echo "WARNING: unable to resolve the current WSL client IP; Todo MCP is disabled for this launch." >&2
        return 0
    fi
    windows_script="$(wslpath -w "$AICODE_SOURCE_DIR/todo-mcp-bridge.ps1" 2>/dev/null || true)"
    if [ -z "$windows_script" ]; then
        echo "WARNING: unable to resolve the Windows bridge script path; Todo MCP is disabled for this launch." >&2
        return 0
    fi

    echo "Starting the WSL-side Todo MCP reverse relay..."
    if ! python3 "$AICODE_SOURCE_DIR/todo-mcp-local-proxy.py" \
        --reverse-listen-host "$wsl_client_ip" \
        --reverse-listen-port 18766 \
        --allowed-reverse-client "$windows_host_ip" \
        --channel-count 8 \
        --listen-port 8766 \
        --state-dir "$HOME/.cache/globalskills/todo-mcp-bridge"; then
        echo "WARNING: WSL Todo MCP reverse relay could not start; see ~/.cache/globalskills/todo-mcp-bridge/bridge.log." >&2
        return 0
    fi

    echo "Ensuring the Windows Todo MCP bridge opens outbound channels to WSL..."
    if ! powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$windows_script" \
        -Action Ensure -RelayAddress "$wsl_client_ip" -RelayPort 18766 -ChannelCount 8; then
        echo "WARNING: Windows Todo MCP reverse bridge could not connect; check %LOCALAPPDATA%\GlobalSkills\TodoMcpBridge\bridge-error.log." >&2
        return 0
    fi

    local http_status
    http_status="$(todo_local_mcp_probe_status "http://127.0.0.1:8766/mcp")"
    if [ "$http_status" = "200" ]; then
        export TODO_LOCAL_MCP_URL="http://127.0.0.1:8766/mcp"
        export TODO_LOCAL_MCP_AVAILABLE=1 TODO_LOCAL_MCP_CONNECTED=1
        echo "Todo MCP initialize and tools/list handshake succeeded through the reverse bridge at $TODO_LOCAL_MCP_URL."
    else
        echo "WARNING: Todo MCP reverse bridge did not complete an unauthenticated initialize/tools/list handshake (probe status $http_status). Todo MCP is disabled for this launch." >&2
        tail -n 12 "$HOME/.cache/globalskills/todo-mcp-bridge/bridge.log" 2>/dev/null | sed 's/^/  WSL relay: /' >&2
        powershell.exe -NoProfile -NonInteractive -Command '$root = Join-Path $env:LOCALAPPDATA "GlobalSkills\TodoMcpBridge"; $logFile = Join-Path $root "bridge.log"; if (Test-Path -LiteralPath $logFile) { Get-Content -LiteralPath $logFile -Tail 12 }' 2>/dev/null | tr -d '\r' | sed 's/^/  Windows bridge: /' >&2
        echo "Check that Todo Desktop is running with todo.localMcpServer enabled." >&2
    fi
    return 0
}

verify_opencode_caracal_config() {
    # Keep using the operator-owned static config, but do not make Caracal
    # connectivity a prerequisite for launching Manul/OpenCode.
    if [ -z "${OPENCODE_CONFIG:-}" ]; then
        local config_root="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
        # Prefer the canonical JSON config when both formats exist. Operators
        # may keep an empty JSONC template beside the fully configured JSON file.
        if [ -r "$config_root/opencode.json" ]; then
            OPENCODE_CONFIG="$config_root/opencode.json"
        elif [ -r "$config_root/opencode.jsonc" ]; then
            OPENCODE_CONFIG="$config_root/opencode.jsonc"
        else
            OPENCODE_CONFIG="$config_root/opencode.json"
        fi
    fi
    export OPENCODE_CONFIG
    echo "Using static OpenCode config: $OPENCODE_CONFIG."

    local opencode_cli mcp_output mcp_status=0 probe_timeout
    if [ ! -r "$OPENCODE_CONFIG" ]; then
        echo "WARNING: static OpenCode config is missing/unreadable: $OPENCODE_CONFIG; continuing without Caracal connectivity verification." >&2
        return 0
    fi
    if [ -n "${OPENCODE_BIN:-}" ] && [ -x "$OPENCODE_BIN" ]; then
        opencode_cli="$OPENCODE_BIN"
    else
        opencode_cli="$(command -v opencode 2>/dev/null || true)"
    fi
    if [ -z "$opencode_cli" ] || [ ! -x "$opencode_cli" ]; then
        echo "WARNING: OpenCode CLI is not executable; skipping the optional Caracal MCP startup probe." >&2
        return 0
    fi

    probe_timeout="${CARACAL_MCP_PROBE_TIMEOUT:-2}"
    if ! [[ "$probe_timeout" =~ ^[0-9]{1,2}$ ]] || (( probe_timeout < 1 || probe_timeout > 10 )); then
        probe_timeout=2
    fi
    mcp_output="$(timeout "$probe_timeout" "$opencode_cli" mcp list 2>&1)" || mcp_status=$?
    if printf '%s\n' "$mcp_output" |
        grep -Eiq '(^|[[:space:]])caracal-rag[[:space:]]+connected([[:space:]]|$|\()'; then
        echo "OpenCode reports caracal-rag connected; operator config left unchanged."
    else
        echo "WARNING: Caracal MCP is not connected yet (mcp list exit $mcp_status); continuing startup without waiting." >&2
        if [ -n "$mcp_output" ]; then
            printf '%s\n' "$mcp_output" | tail -n 6 >&2
        fi
    fi

    if [ "${TODO_LOCAL_MCP_AVAILABLE:-0}" = "1" ] &&
       ! printf '%s\n' "$mcp_output" |
           grep -Eiq '(^|[[:space:]])todo-local[[:space:]]+connected([[:space:]]|$|\()'; then
        echo "WARNING: optional todo-local MCP is not connected in OpenCode; continuing without Todo tools." >&2
    fi
    return 0
}

configure_openclaw_opencode_acp() {
    local snapshot snapshot_config base_hash patch params verified
    local wrapper="$HOME/.globalskills/aicode/opencode-acp-caracal.sh"

    if [ ! -r "$wrapper" ]; then
        echo "ERROR: OpenCode ACP Caracal wrapper is missing: $wrapper" >&2
        return 1
    fi

    # The helper captures the CLI exit status before parsing stdout, strips
    # only the known advisory prefix, and validates the config plus raw file hash.
    if ! snapshot="$(openclaw_config_get_snapshot)"; then
        echo "ERROR: OpenClaw config snapshot is invalid or missing its config/file hash." >&2
        return 1
    fi
    base_hash="$(printf '%s\n' "$snapshot" | openclaw_config_snapshot_base_hash)" || {
        echo "ERROR: OpenClaw config snapshot did not include a valid file revision hash." >&2
        return 1
    }
    snapshot_config="$(printf '%s\n' "$snapshot" | openclaw_config_snapshot_config)" || {
        echo "ERROR: OpenClaw config snapshot did not include a valid config object." >&2
        return 1
    }

    # ACPX owns the OpenCode harness process. Configure that one target to use a
    # wrapper which refreshes Caracal credentials and runs opencode mcp list
    # before opencode acp. Do not register a duplicate native OpenClaw MCP:
    # Caracal tools are provided by the OpenCode harness in this deployment.
    if ! printf '%s\n' "$snapshot_config" | jq -e '.plugins.entries.acpx.enabled == true' >/dev/null 2>&1; then
        echo "ERROR: the OpenClaw ACPX plugin must be installed and enabled before configuring the OpenCode harness." >&2
        return 1
    fi

    # OpenClaw ACP must be explicitly enabled and select the installed
    # ACPX backend. allowedAgents alone does not activate ACP.
    # Avoid writing the Gateway config on every launch once all fields match.
    if printf '%s\n' "$snapshot_config" | jq -e --arg wrapper "$wrapper" '
      (.acp.enabled == true)
      and (.acp.backend == "acpx")
      and (.plugins.entries.acpx.enabled == true)
      and (.plugins.entries.acpx.config.probeAgent == "opencode")
      and (.plugins.entries.acpx.config.agents.opencode.command == "bash")
      and (.plugins.entries.acpx.config.agents.opencode.args == [$wrapper, "acp"])
      and ((.acp.allowedAgents | type) == "array")
      and ((.acp.allowedAgents | index("opencode")) != null)
    ' >/dev/null 2>&1; then
        echo "OpenClaw ACP OpenCode harness already uses the Caracal-verifying wrapper."
        return 0
    fi

    patch="$(printf '%s\n' "$snapshot_config" | jq -c --arg wrapper "$wrapper" '
      . as $cfg
      | {
          plugins: {
            entries: {
              acpx: {
                config: {
                  probeAgent: "opencode",
                  agents: {
                    opencode: {
                      command: "bash",
                      args: [$wrapper, "acp"]
                    }
                  }
                }
              }
            }
          }
        }
        + {
            acp: (
              ($cfg.acp // {})
              | .enabled = true
              | .backend = "acpx"
              | .allowedAgents = (
                  (if (.allowedAgents | type) == "array" then .allowedAgents else [] end)
                  + ["opencode"]
                  | unique
                )
            )
          }
    ')" || {
        echo "ERROR: unable to prepare OpenCode ACP harness configuration." >&2
        return 1
    }
    params="$(jq -cn --arg raw "$patch" --arg baseHash "$base_hash" \
        '{raw:$raw,baseHash:$baseHash,note:"Route OpenClaw ACP OpenCode through the Caracal-verified wrapper"}')" || return 1
    if ! openclaw gateway call config.patch --params "$params" >/dev/null 2>&1; then
        echo "ERROR: OpenClaw rejected the OpenCode ACP harness configuration." >&2
        return 1
    fi

    if ! verified="$(openclaw_config_get_snapshot)" ||
       ! printf '%s\n' "$verified" | jq -e --arg wrapper "$wrapper" '
         (.config.acp.enabled == true)
         and (.config.acp.backend == "acpx")
         and (.config.plugins.entries.acpx.enabled == true)
         and (.config.plugins.entries.acpx.config.probeAgent == "opencode")
         and (.config.plugins.entries.acpx.config.agents.opencode.command == "bash")
         and (.config.plugins.entries.acpx.config.agents.opencode.args == [$wrapper, "acp"])
         and ((.config.acp.allowedAgents | type) == "array")
         and ((.config.acp.allowedAgents | index("opencode")) != null)
       ' >/dev/null 2>&1; then
        echo "ERROR: OpenClaw did not retain the expected OpenCode ACP wrapper configuration." >&2
        return 1
    fi

    echo "OpenClaw ACP OpenCode harness configured with the Caracal-verifying wrapper."
}

# Chroma is a Caracal dependency. Start/reuse it after LiteLLM and before
# launching Caracal's MCP process; embedding readiness is intentionally async.
if [ -r "$AICODE_SOURCE_DIR/chroma-lifecycle.sh" ]; then
    # shellcheck source=aicode/chroma-lifecycle.sh
    . "$AICODE_SOURCE_DIR/chroma-lifecycle.sh"
    ensure_chroma_server "$CARACAL_HOME" || true
else
    echo "WARNING: Chroma lifecycle helper is missing next to aicode; automatic Chroma startup is skipped."
fi

ensure_caracal_mcp || echo "WARNING: Caracal MCP startup failed; continuing with Manul/OpenCode." >&2
ensure_todo_mcp_bridge
verify_opencode_caracal_config
if [ "$AGENT_RUNTIME" = "openclaw" ]; then
    # The ACP wrapper loads current Caracal credentials directly when each
    # OpenCode harness starts, so no Gateway restart is needed just to refresh them.
    GATEWAY_PORT="${OPENCLAW_GATEWAY_PORT:-18789}"
    gateway_responding() {
        curl -fsS --max-time 2 \
            "http://127.0.0.1:${GATEWAY_PORT}" \
            >/dev/null 2>&1
    }

    if ! gateway_responding; then
        nohup openclaw gateway \
            --force \
            --allow-unconfigured \
            --port "$GATEWAY_PORT" \
            >/tmp/openclaw-gateway.log 2>&1 &

        echo "Waiting for OpenClaw Gateway to become ready on 127.0.0.1:${GATEWAY_PORT}..."
        ready=0
        for _ in $(seq 1 20); do
            if gateway_responding; then
                ready=1
                break
            fi
            sleep 1
        done

        if [ "$ready" -eq 1 ]; then
            echo "OpenClaw Gateway is up on http://127.0.0.1:${GATEWAY_PORT}"
        else
            echo "ERROR: OpenClaw Gateway did not become ready; see /tmp/openclaw-gateway.log" >&2
            exit 1
        fi
    else
        echo "OpenClaw Gateway is already running on http://127.0.0.1:${GATEWAY_PORT}"
    fi

    if ! configure_openclaw_opencode_acp; then
        exit 1
    fi
else
    # In direct OpenCode mode, ACPX is irrelevant: Manul starts OpenCode
    # through its own adapter and must not touch the OpenClaw Gateway.
    echo "OpenClaw Gateway/ACPX skipped (Manul agentRuntime=$AGENT_RUNTIME)."
fi

# Ensure Manul GitHub bot daemon is running.
# Never let a broken/hung daemon block OpenCode startup.
# The canonical installer/repairer is authoritative for ~/.manul runtime state.
MANUL_INSTALLER="$MANUL_CANONICAL_DIR/install-manul.sh"
MANUL_REPAIRER="$MANUL_CANONICAL_DIR/repair-manul-runtime.sh"
MANUL_RUNTIME="$MANUL_DIR"
MANUL_DB="$MANUL_RUNTIME/state/manul.db"
MANUL_SCRIPT="$MANUL_RUNTIME/manul-daemon.sh"
MANUL_LOG="/tmp/manul-daemon.log"
MANUL_ENV_HELPER="$MANUL_CANONICAL_DIR/manul-env.sh"

# Prepare the Manul-specific integration fallback file. Exported shell/provider
# settings come from ~/.zshrc and are inherited by the daemon/watchdog through
# Manul's Zsh bootstrap; this helper does not copy them into ~/.manul/.env.
# Caracal remains owned by aicode/OpenCode and is never persisted as a Manul
# dependency.
if [ ! -r "$MANUL_ENV_HELPER" ]; then
    echo "ERROR: Manul environment helper is missing: $MANUL_ENV_HELPER" >&2
    exit 1
fi
# shellcheck source=~/.manul-repo/skills/manul-github-bot/manul-env.sh
source "$MANUL_ENV_HELPER" || {
    echo "ERROR: could not load the Manul environment helper." >&2
    exit 1
}
if ! manul_env_bootstrap "$MANUL_RUNTIME" >/dev/null; then
    echo "ERROR: could not prepare Manul integration fallbacks." >&2
    exit 1
fi

# Prepare Manul without ever replacing existing task state implicitly.
# repair-manul-runtime.sh restores a missing/corrupt DB from a known backup.
# Only a truly fresh runtime with no recoverable DB may use --init-state.
if [ -x "$MANUL_REPAIRER" ]; then
    if ! "$MANUL_REPAIRER" >/dev/null 2>&1; then
        if [ ! -f "$MANUL_DB" ] && [ -x "$MANUL_INSTALLER" ]; then
            if ! "$MANUL_INSTALLER" --init-state >/dev/null 2>&1; then
                echo "WARNING: Manul fresh initialization failed; continuing with OpenCode."
            fi
        else
            echo "WARNING: Manul runtime repair failed; continuing with OpenCode."
        fi
    fi
elif [ -x "$MANUL_INSTALLER" ]; then
    if [ ! -f "$MANUL_DB" ]; then
        if ! "$MANUL_INSTALLER" --init-state >/dev/null 2>&1; then
            echo "WARNING: Manul fresh initialization failed; continuing with OpenCode."
        fi
    elif ! "$MANUL_INSTALLER" >/dev/null 2>&1; then
        echo "WARNING: Manul installer validation failed; continuing with OpenCode."
    fi
fi

if [ -x "$MANUL_SCRIPT" ]; then
    if timeout 15 "$MANUL_SCRIPT" start >"$MANUL_LOG" 2>&1; then
        echo "Manul daemon start request completed. Check ~/.manul/logs/daemon.log for task-source preflight results."
    else
        rc=$?
        if [ "$rc" -eq 124 ]; then
            echo "WARNING: Manul daemon startup timed out after 15s; continuing with OpenCode."
        else
            echo "WARNING: Manul daemon startup failed (exit $rc); continuing with OpenCode."
        fi
        echo "See $MANUL_LOG for details."
    fi
else
    echo "WARNING: Manul daemon script not found/executable: $MANUL_SCRIPT"
fi

# All chat roles use the single FreeLLMAPI-backed LiteLLM model group.
echo "Chat model via LiteLLM: litellm/free-cloud"
if [ "$AGENT_RUNTIME" = "openclaw" ]; then
    echo "OpenClaw Gateway: http://127.0.0.1:${GATEWAY_PORT} (openclaw dashboard)"
else
    echo "OpenClaw Gateway not required (Manul agentRuntime=$AGENT_RUNTIME)."
fi

type -p opencode >/dev/null 2>&1 || {
    echo "ERROR: opencode command not found in PATH." >&2
    exit 127
}

exec opencode "$@" --auto
