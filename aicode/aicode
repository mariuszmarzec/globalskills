#!/bin/bash
# aicode - Start AI dev environment and launch OpenCode

export PATH="$HOME/.opencode/bin:$PATH"

if [ -f "$HOME/.config/opencode/opencode.env" ]; then
    set -a
    . "$HOME/.config/opencode/opencode.env"
    set +a
fi

if [ -z "${OPENCODE_API_KEY:-}" ]; then
    echo "WARNING: OPENCODE_API_KEY is not set; OpenCode Zen will be unavailable."
fi

# Ensure Ollama is running
if ! pgrep -x "ollama" >/dev/null; then
    echo "Starting Ollama..."
    nohup ollama serve >/tmp/ollama.log 2>&1 &
    sleep 3
fi

# Ensure PostgreSQL is available for LiteLLM UI/auth
if command -v pg_isready >/dev/null 2>&1; then
    if ! pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1; then
        if command -v service >/dev/null 2>&1; then
            sudo -n service postgresql start >/dev/null 2>&1 || true
        fi
        if command -v pg_ctlcluster >/dev/null 2>&1; then
            sudo -n pg_ctlcluster 12 main start >/dev/null 2>&1 || true
        fi
        sleep 3
    fi

    if pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1; then
        if ! sudo -n -u postgres psql -Atqc \
            "SELECT 1 FROM pg_roles WHERE rolname='litellm'" 2>/dev/null | grep -qx '1'; then
            echo "Creating PostgreSQL user/database for LiteLLM..."
            sudo -n -u postgres psql \
                -c "CREATE USER litellm WITH PASSWORD 'litellm';" \
                >/dev/null 2>&1 || true
            sudo -n -u postgres psql \
                -c "CREATE DATABASE litellm OWNER litellm;" \
                >/dev/null 2>&1 || true
        fi
    fi
fi

# Ensure LiteLLM is running
if ! pgrep -f '[l]itellm' >/dev/null; then
    if [ -f "$HOME/litellm/.env" ]; then
        set -a
        . "$HOME/litellm/.env"
        set +a
    fi
    echo "Starting LiteLLM..."
    if [ -x /home/marzec/.local/bin/litellm ]; then
        nohup python3.12 /home/marzec/.local/bin/litellm \
            --config "$HOME/litellm/config.yaml" \
            --port 4000 \
            >/tmp/litellm.log 2>&1 &
    else
        nohup litellm \
            --config "$HOME/litellm/config.yaml" \
            --port 4000 \
            >/tmp/litellm.log 2>&1 &
    fi
    sleep 3
fi


# Start Caracal RAG after LiteLLM. Only attach credentials to a service that
# this launcher verifies it owns; never kill processes by a fuzzy name.
CARACAL_HOME="${CARACAL_HOME:-$HOME/.caracal}"
export CARACAL_HOME
CARACAL_CLI="$CARACAL_HOME/bin/caracal-rag"
CARACAL_RUN_DIR="$CARACAL_HOME/run"
CARACAL_PID_FILE="$CARACAL_RUN_DIR/mcp.pid"
CARACAL_LOG="/tmp/caracal-mcp.log"

caracal_http_ready() {
    local url="$1" status
    status="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 2 "$url" 2>/dev/null || true)"
    [[ "$status" =~ ^[1-4][0-9][0-9]$ ]]
}

caracal_pid_matches() {
    local pid="$1" command_line
    [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]] || return 1
    command_line="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
    [[ "$command_line" == *"caracal-rag mcp --transport http"* &&
       "$command_line" == *"--port $CARACAL_MCP_PORT"* &&
       "$command_line" == *"--path $CARACAL_MCP_PATH"* ]]
}

caracal_load_access_token() {
    if [ -z "${CARACAL_ACCESS_TOKEN:-}" ] &&
       [ -x "$CARACAL_HOME/venv/bin/python" ] &&
       [ -f "$CARACAL_HOME/config/secrets.yaml" ]; then
        CARACAL_ACCESS_TOKEN="$("$CARACAL_HOME/venv/bin/python" - "$CARACAL_HOME/config/secrets.yaml" 2>/dev/null <<'PY'
import sys
from pathlib import Path
from caracal_rag.config import load_secrets
print(load_secrets(Path(sys.argv[1])).get("access_token", ""), end="")
PY
)" || CARACAL_ACCESS_TOKEN=""
    fi

    if [ -z "${CARACAL_ACCESS_TOKEN:-}" ]; then
        echo "ERROR: Caracal access token is unavailable; no agent runtime will start." >&2
        return 1
    fi
    # Caracal uses an opaque bearer token. Refuse control characters or syntax
    # that cannot be represented safely in the dotenv files used by the runtimes.
    if [[ ! "$CARACAL_ACCESS_TOKEN" =~ ^[A-Za-z0-9._~+/=-]+$ ]]; then
        echo "ERROR: Caracal token contains unsupported characters for runtime environment configuration." >&2
        return 1
    fi
    export CARACAL_ACCESS_TOKEN
}

ensure_caracal_mcp() {
    if ! caracal_load_access_token; then
        return 1
    fi

    # An explicitly configured URL opts into an externally managed endpoint.
    # It still must be reachable here and pass real authenticated probes below.
    if [ -n "${CARACAL_MCP_URL:-}" ]; then
        case "$CARACAL_MCP_URL" in
            http://*|https://*) ;;
            *)
                echo "ERROR: CARACAL_MCP_URL must be an absolute HTTP(S) URL." >&2
                return 1
                ;;
        esac
        if [[ "$CARACAL_MCP_URL" == *[$'\r\n\"']* ]]; then
            echo "ERROR: CARACAL_MCP_URL contains unsupported control/quote characters." >&2
            return 1
        fi
        if ! caracal_http_ready "$CARACAL_MCP_URL"; then
            echo "ERROR: explicitly configured Caracal MCP endpoint is not reachable." >&2
            return 1
        fi
        export CARACAL_MCP_REQUIRED=1
        echo "Using the explicitly configured, reachable Caracal MCP endpoint."
        return 0
    fi

    # Keep the configuration visibly disconnected until local startup is proven.
    export CARACAL_MCP_URL="http://127.0.0.1:0/mcp"
    if [ ! -x "$CARACAL_CLI" ]; then
        echo "ERROR: Caracal is not installed at $CARACAL_CLI; refusing to start an agent without MCP." >&2
        return 1
    fi

    local check_output mcp_host mcp_port mcp_path mcp_url
    if ! check_output="$("$CARACAL_CLI" check 2>&1)"; then
        echo "ERROR: Caracal healthcheck failed; MCP was not started." >&2
        printf '%s\n' "$check_output" | tail -n 8 >&2
        return 1
    fi

    mcp_host="$(printf '%s\n' "$check_output" | sed -n 's/.*mcp_host=\([^ ]*\).*/\1/p' | tail -n 1)"
    mcp_port="$(printf '%s\n' "$check_output" | sed -n 's/.*mcp_port=\([^ ]*\).*/\1/p' | tail -n 1)"
    mcp_path="$(printf '%s\n' "$check_output" | sed -n 's/.*mcp_path=\([^ ]*\).*/\1/p' | tail -n 1)"

    if [ "$mcp_host" != "127.0.0.1" ] ||
       ! [[ "$mcp_port" =~ ^[0-9]{1,5}$ ]] ||
       (( mcp_port < 1 || mcp_port > 65535 )) ||
       ! [[ "$mcp_path" =~ ^/[A-Za-z0-9/_-]+$ ]]; then
        echo "ERROR: Caracal must use loopback HTTP with a valid port and absolute MCP path." >&2
        return 1
    fi

    CARACAL_MCP_PORT="$mcp_port"
    CARACAL_MCP_PATH="$mcp_path"
    mcp_url="http://127.0.0.1:$mcp_port$mcp_path"

    if [ -L "$CARACAL_RUN_DIR" ] || [ -L "$CARACAL_PID_FILE" ]; then
        echo "ERROR: refusing symlinked Caracal runtime/PID path; inspect $CARACAL_RUN_DIR." >&2
        return 1
    fi
    mkdir -p "$CARACAL_RUN_DIR" || return 1
    chmod 0700 "$CARACAL_RUN_DIR"

    if [ -e "$CARACAL_PID_FILE" ]; then
        if [ ! -f "$CARACAL_PID_FILE" ]; then
            echo "ERROR: refusing unexpected Caracal PID path: $CARACAL_PID_FILE" >&2
            return 1
        fi
        local old_pid
        IFS= read -r old_pid < "$CARACAL_PID_FILE" || old_pid=""
        if caracal_pid_matches "$old_pid"; then
            for _ in $(seq 1 20); do
                if caracal_http_ready "$mcp_url"; then
                    export CARACAL_MCP_URL="$mcp_url" CARACAL_MCP_REQUIRED=1
                    echo "Caracal MCP already running at $mcp_url (PID $old_pid)."
                    return 0
                fi
                if ! kill -0 "$old_pid" 2>/dev/null; then
                    break
                fi
                sleep 1
            done
            echo "ERROR: tracked Caracal MCP process is not responding; see $CARACAL_LOG." >&2
            return 1
        fi
        rm -f -- "$CARACAL_PID_FILE"
    fi

    if caracal_http_ready "$mcp_url"; then
        echo "ERROR: $mcp_url responds but is not owned by a valid Caracal PID file; refusing to attach credentials." >&2
        return 1
    fi

    umask 077
    touch "$CARACAL_LOG" || return 1
    chmod 0600 "$CARACAL_LOG"
    echo "Starting Caracal MCP after LiteLLM..."
    nohup "$CARACAL_CLI" mcp --transport http --host 127.0.0.1 --port "$mcp_port" --path "$mcp_path" \
        </dev/null >>"$CARACAL_LOG" 2>&1 &
    local caracal_pid=$!
    printf '%s\n' "$caracal_pid" > "$CARACAL_PID_FILE" || return 1
    chmod 0600 "$CARACAL_PID_FILE"
    umask 022

    for _ in $(seq 1 20); do
        if caracal_http_ready "$mcp_url" && caracal_pid_matches "$caracal_pid"; then
            export CARACAL_MCP_URL="$mcp_url" CARACAL_MCP_REQUIRED=1
            echo "Caracal MCP ready at $mcp_url."
            return 0
        fi
        if ! kill -0 "$caracal_pid" 2>/dev/null; then
            break
        fi
        sleep 1
    done

    echo "ERROR: Caracal MCP did not become ready; see $CARACAL_LOG. No agent runtime will start." >&2
    if ! kill -0 "$caracal_pid" 2>/dev/null; then
        rm -f -- "$CARACAL_PID_FILE"
    fi
    return 1
}

ensure_opencode_caracal_config() {
    OPENCODE_CONFIG="${OPENCODE_CONFIG:-$HOME/.config/opencode/opencode.json}"
    export OPENCODE_CONFIG
    local config_dir tmp config_input
    config_dir="$(dirname -- "$OPENCODE_CONFIG")"
    mkdir -p "$config_dir" || return 1
    if [ -L "$OPENCODE_CONFIG" ]; then
        echo "ERROR: refusing symlinked OpenCode config path: $OPENCODE_CONFIG" >&2
        return 1
    fi
    tmp="$(mktemp "$config_dir/.opencode-caracal.XXXXXX")" || return 1
    if [ -f "$OPENCODE_CONFIG" ]; then
        config_input="$OPENCODE_CONFIG"
    else
        config_input="/dev/null"
    fi
    if ! jq -s '
        (.[0] // {})
        # OpenCode's MCP schema is .mcp[server-name], unlike OpenClaw's
        # separate .mcp.servers schema.
        | .mcp = (
            (.mcp // {}) | if type == "object" then . else {} end
            | . + {
                "caracal-rag": {
                    type: "remote",
                    url: "{env:CARACAL_MCP_URL}",
                    oauth: false,
                    enabled: true,
                    headers: {Authorization: "Bearer {env:CARACAL_ACCESS_TOKEN}"}
                }
            }
          )
        | .tools = ((.tools // {}) | if type == "object" then . else {} end | . + {"caracal-rag_*": true})
        | .agent = (
            (.agent // {})
            | if type == "object" then
                with_entries(
                  if .key == "chat" then .
                  else .value.tools = ((.value.tools // {}) | if type == "object" then . else {} end | . + {"caracal-rag_*": true})
                  end
                )
              else {}
              end
          )
    ' "$config_input" > "$tmp"; then
        rm -f -- "$tmp"
        echo "ERROR: unable to merge Caracal MCP into the OpenCode config." >&2
        return 1
    fi
    if [ -f "$OPENCODE_CONFIG" ] && cmp -s "$tmp" "$OPENCODE_CONFIG"; then
        rm -f -- "$tmp"
    else
        if [ -f "$OPENCODE_CONFIG" ]; then
            cp -p -- "$OPENCODE_CONFIG" "$OPENCODE_CONFIG.bak.$(date +%Y%m%d-%H%M%S)" || { rm -f -- "$tmp"; return 1; }
            chmod --reference="$OPENCODE_CONFIG" "$tmp" 2>/dev/null || true
        else
            chmod 0600 "$tmp"
        fi
        mv -- "$tmp" "$OPENCODE_CONFIG" || { rm -f -- "$tmp"; return 1; }
        echo "OpenCode Caracal MCP config updated (backup retained when replacing an existing file)."
    fi

    local mcp_output opencode_cli
    if [ -n "${OPENCODE_BIN:-}" ] && [ -x "$OPENCODE_BIN" ]; then
        opencode_cli="$OPENCODE_BIN"
    else
        opencode_cli="$(command -v opencode 2>/dev/null || true)"
    fi
    if [ -z "$opencode_cli" ] || [ ! -x "$opencode_cli" ]; then
        echo "ERROR: OpenCode CLI is not executable; cannot verify Caracal MCP." >&2
        return 1
    fi
    if ! mcp_output="$("$opencode_cli" mcp list 2>&1)" ||
       ! printf '%s\n' "$mcp_output" | grep -Eiq 'caracal-rag[[:space:]].*connected|connected.*caracal-rag'; then
        echo "ERROR: OpenCode does not report caracal-rag as connected; see the output of 'opencode mcp list'. No agent runtime will start." >&2
        return 1
    fi
    echo "OpenCode reports caracal-rag connected."
}

configure_openclaw_opencode_acp() {
    local snapshot snapshot_config base_hash patch params verified
    local wrapper="$HOME/.globalskills/aicode/opencode-acp-caracal.sh"

    if [ ! -r "$wrapper" ]; then
        echo "ERROR: OpenCode ACP Caracal wrapper is missing: $wrapper" >&2
        return 1
    fi

    if ! snapshot="$(openclaw gateway call config.get --params '{}' 2>/dev/null)"; then
        echo "ERROR: could not read the active OpenClaw config through the Gateway." >&2
        return 1
    fi
    base_hash="$(printf '%s\n' "$snapshot" | jq -r '.payload.hash // .hash // empty' 2>/dev/null)"
    snapshot_config="$(printf '%s\n' "$snapshot" | jq -ce '.payload.config // .config // empty' 2>/dev/null)" || true
    if [ -z "$base_hash" ] || [ -z "$snapshot_config" ]; then
        echo "ERROR: OpenClaw config snapshot did not include its config and revision hash." >&2
        return 1
    fi

    # ACPX owns the OpenCode harness process. Configure that one target to use a
    # wrapper which refreshes Caracal credentials and runs opencode mcp list
    # before opencode acp. Do not register a duplicate native OpenClaw MCP:
    # Caracal tools are provided by the OpenCode harness in this deployment.
    if ! printf '%s\n' "$snapshot_config" | jq -e '.plugins.entries.acpx.enabled == true' >/dev/null 2>&1; then
        echo "ERROR: the OpenClaw ACPX plugin must be installed and enabled before configuring the OpenCode harness." >&2
        return 1
    fi

    patch="$(printf '%s\n' "$snapshot_config" | jq -c --arg wrapper "$wrapper" '
      . as $cfg
      | {
          plugins: {
            entries: {
              acpx: {
                config: {
                  agents: {
                    opencode: {
                      command: "bash",
                      args: [$wrapper, "acp"]
                    }
                  }
                }
              }
            }
          }
        }
        + (if ($cfg.acp.allowedAgents | type) == "array" then
             {acp: {allowedAgents: (($cfg.acp.allowedAgents + ["opencode"]) | unique)}}
           else {} end)
    ')" || {
        echo "ERROR: unable to prepare OpenCode ACP harness configuration." >&2
        return 1
    }
    params="$(jq -cn --arg raw "$patch" --arg baseHash "$base_hash" \
        '{raw:$raw,baseHash:$baseHash,note:"Route OpenClaw ACP OpenCode through the Caracal-verified wrapper"}')" || return 1
    if ! openclaw gateway call config.patch --params "$params" >/dev/null 2>&1; then
        echo "ERROR: OpenClaw rejected the OpenCode ACP harness configuration." >&2
        return 1
    fi

    if ! verified="$(openclaw gateway call config.get --params '{}' 2>/dev/null)" ||
       ! printf '%s\n' "$verified" | jq -e --arg wrapper "$wrapper" '
         (.payload.config.plugins.entries.acpx.config.agents.opencode.command == "bash")
         and (.payload.config.plugins.entries.acpx.config.agents.opencode.args == [$wrapper, "acp"])
         and (
           ((.payload.config.acp.allowedAgents | type) != "array")
           or ((.payload.config.acp.allowedAgents | index("opencode")) != null)
         )
       ' >/dev/null 2>&1; then
        echo "ERROR: OpenClaw did not retain the expected OpenCode ACP wrapper configuration." >&2
        return 1
    fi

    echo "OpenClaw ACP OpenCode harness configured with the Caracal-verifying wrapper."
}

# Chroma is a separate local database service; Caracal's check needs it reachable.
# An explicit CARACAL_MCP_URL means the MCP endpoint is externally managed, so
# do not start a local Chroma instance for that mode.
if [ -z "${CARACAL_MCP_URL:-}" ]; then
    AICODE_SOURCE_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
    AICODE_SOURCE_DIR="$(cd -- "$(dirname -- "$AICODE_SOURCE_PATH")" && pwd -P)"
    if [ -r "$AICODE_SOURCE_DIR/chroma-lifecycle.sh" ]; then
        # shellcheck source=aicode/chroma-lifecycle.sh
        . "$AICODE_SOURCE_DIR/chroma-lifecycle.sh"
        ensure_chroma_server "$CARACAL_HOME" || true
    else
        echo "WARNING: Chroma lifecycle helper is missing next to aicode; automatic Chroma startup is skipped."
    fi
fi

if ! ensure_caracal_mcp; then
    exit 1
fi
if ! ensure_opencode_caracal_config; then
    exit 1
fi
# The ACP wrapper loads current Caracal credentials directly when each
# OpenCode harness starts, so no Gateway restart is needed just to refresh them.
GATEWAY_PORT="${OPENCLAW_GATEWAY_PORT:-18789}"
gateway_responding() {
    curl -fsS --max-time 2 \
        "http://127.0.0.1:${GATEWAY_PORT}" \
        >/dev/null 2>&1
}

if ! gateway_responding; then
    nohup openclaw gateway \
        --force \
        --allow-unconfigured \
        --port "$GATEWAY_PORT" \
        >/tmp/openclaw-gateway.log 2>&1 &

    echo "Waiting for OpenClaw Gateway to become ready on 127.0.0.1:${GATEWAY_PORT}..."
    ready=0
    for _ in $(seq 1 20); do
        if gateway_responding; then
            ready=1
            break
        fi
        sleep 1
    done

    if [ "$ready" -eq 1 ]; then
        echo "OpenClaw Gateway is up on http://127.0.0.1:${GATEWAY_PORT}"
    else
        echo "ERROR: OpenClaw Gateway did not become ready; see /tmp/openclaw-gateway.log" >&2
        exit 1
    fi
else
    echo "OpenClaw Gateway is already running on http://127.0.0.1:${GATEWAY_PORT}"
fi

if ! configure_openclaw_opencode_acp; then
    exit 1
fi

# Ensure Manul GitHub bot daemon is running.
# Never let a broken/hung daemon block OpenCode startup.
# The canonical installer/repairer is authoritative for ~/.manul runtime state.
MANUL_INSTALLER="$HOME/.globalskills/skills/manul-github-bot/install-manul.sh"
MANUL_REPAIRER="$HOME/.globalskills/skills/manul-github-bot/repair-manul-runtime.sh"
MANUL_RUNTIME="${MANUL_RUNTIME_DIR:-$HOME/.manul}"
MANUL_DB="$MANUL_RUNTIME/manul.db"
MANUL_SCRIPT="$MANUL_RUNTIME/manul-daemon.sh"
MANUL_LOG="/tmp/manul-daemon.log"
MANUL_ENV_HELPER="$HOME/.globalskills/skills/manul-github-bot/manul-env.sh"

# Refresh the Caracal endpoint/token pair before any installer, repairer or
# existing daemon can load a stale ~/.manul/.env. This update is atomic and
# preserves unrelated operator-owned values.
if [ ! -r "$MANUL_ENV_HELPER" ]; then
    echo "ERROR: Manul environment helper is missing: $MANUL_ENV_HELPER" >&2
    exit 1
fi
# shellcheck source=skills/manul-github-bot/manul-env.sh
source "$MANUL_ENV_HELPER" || {
    echo "ERROR: could not load the Manul environment helper." >&2
    exit 1
}
if ! manul_env_bootstrap "$MANUL_RUNTIME" >/dev/null; then
    echo "ERROR: could not persist the current Caracal MCP endpoint/token for Manul." >&2
    exit 1
fi

# Prepare Manul without ever replacing existing task state implicitly.
# repair-manul-runtime.sh restores a missing/corrupt DB from a known backup.
# Only a truly fresh runtime with no recoverable DB may use --init-state.
if [ -x "$MANUL_REPAIRER" ]; then
    if ! "$MANUL_REPAIRER" >/dev/null 2>&1; then
        if [ ! -f "$MANUL_DB" ] && [ -x "$MANUL_INSTALLER" ]; then
            if ! "$MANUL_INSTALLER" --init-state >/dev/null 2>&1; then
                echo "WARNING: Manul fresh initialization failed; continuing with OpenCode."
            fi
        else
            echo "WARNING: Manul runtime repair failed; continuing with OpenCode."
        fi
    fi
elif [ -x "$MANUL_INSTALLER" ]; then
    if [ ! -f "$MANUL_DB" ]; then
        if ! "$MANUL_INSTALLER" --init-state >/dev/null 2>&1; then
            echo "WARNING: Manul fresh initialization failed; continuing with OpenCode."
        fi
    elif ! "$MANUL_INSTALLER" >/dev/null 2>&1; then
        echo "WARNING: Manul installer validation failed; continuing with OpenCode."
    fi
fi

if [ -x "$MANUL_SCRIPT" ]; then
    if timeout 5 "$MANUL_SCRIPT" start >"$MANUL_LOG" 2>&1; then
        echo "Manul daemon ready."
    else
        rc=$?
        if [ "$rc" -eq 124 ]; then
            echo "WARNING: Manul daemon startup timed out after 5s; continuing with OpenCode."
        else
            echo "WARNING: Manul daemon startup failed (exit $rc); continuing with OpenCode."
        fi
        echo "See $MANUL_LOG for details."
    fi
else
    echo "WARNING: Manul daemon script not found/executable: $MANUL_SCRIPT"
fi

# Launch OpenCode
if [ -n "${OPENCODE_API_KEY:-}" ]; then
    echo "OpenCode Zen API key detected; all Zen models available."
else
    echo "No OPENCODE_API_KEY detected; Zen models unavailable."
fi

echo "Local model via LiteLLM: litellm/local-coder (Gemma 4 12B)"
echo "OpenClaw Gateway: http://127.0.0.1:${GATEWAY_PORT} (openclaw dashboard)"

type -p opencode >/dev/null 2>&1 || {
    echo "ERROR: opencode command not found in PATH." >&2
    exit 127
}

exec opencode "$@" --auto
