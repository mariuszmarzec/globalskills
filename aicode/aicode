#!/bin/bash
# aicode - Start AI dev environment and launch OpenCode

export PATH="$HOME/.opencode/bin:$PATH"

AICODE_SOURCE_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
AICODE_SOURCE_DIR="$(cd -- "$(dirname -- "$AICODE_SOURCE_PATH")" && pwd -P)"

TODO_LOCAL_MCP_URL_HELPER="$AICODE_SOURCE_DIR/../skills/manul-github-bot/todo-local-mcp-url.sh"
if [ -r "$TODO_LOCAL_MCP_URL_HELPER" ]; then
    # shellcheck source=skills/manul-github-bot/todo-local-mcp-url.sh
    . "$TODO_LOCAL_MCP_URL_HELPER"
else
    echo "WARNING: shared Todo MCP endpoint helper is missing; Todo MCP will be disabled." >&2
fi

if [ -f "$HOME/.config/opencode/opencode.env" ]; then
    set -a
    . "$HOME/.config/opencode/opencode.env"
    set +a
fi

if [ -z "${TODO_LOCAL_MCP_TOKEN:-}" ] && [ -f "$HOME/.config/opencode/todo-mcp.env" ]; then
    set -a
    . "$HOME/.config/opencode/todo-mcp.env"
    set +a
fi

if [ -z "${OPENCODE_API_KEY:-}" ]; then
    echo "WARNING: OPENCODE_API_KEY is not set; OpenCode Zen will be unavailable."
fi

# Resolve Manul's automatic agent runtime before touching OpenClaw. Use the
# same config/env precedence as Manul itself; selecting OpenCode means this
# launcher must not start, query, or configure an OpenClaw Gateway.
MANUL_RUNTIME_DIR="${MANUL_RUNTIME_DIR:-$HOME/.manul}"
MANUL_DIR="${MANUL_DIR:-$MANUL_RUNTIME_DIR}"
export MANUL_DIR
MANUL_PATHS_HELPER="$HOME/.globalskills/skills/manul-github-bot/manul-paths.sh"
if [ ! -r "$MANUL_PATHS_HELPER" ]; then
    echo "ERROR: Manul runtime selector is missing: $MANUL_PATHS_HELPER" >&2
    exit 1
fi
# shellcheck source=skills/manul-github-bot/manul-paths.sh
. "$MANUL_PATHS_HELPER"

OPENCLAW_SNAPSHOT_HELPER="$AICODE_SOURCE_DIR/openclaw-config-snapshot.sh"
if [ "$AGENT_RUNTIME" = "openclaw" ]; then
    if [ ! -r "$OPENCLAW_SNAPSHOT_HELPER" ]; then
        echo "ERROR: OpenClaw config snapshot helper is missing: $OPENCLAW_SNAPSHOT_HELPER" >&2
        exit 1
    fi
    # shellcheck source=aicode/openclaw-config-snapshot.sh
    . "$OPENCLAW_SNAPSHOT_HELPER"
else
    echo "Manul agentRuntime=$AGENT_RUNTIME; skipping OpenClaw Gateway and ACPX setup."
fi

# Ensure Ollama's HTTP API is actually ready before anything that may use
# local models starts. A process check is insufficient: Ollama can exist while
# its server is still loading, and an existing but not-yet-ready process must
# also be awaited.
OLLAMA_BASE_URL="${OLLAMA_BASE_URL:-http://127.0.0.1:11434}"
OLLAMA_READY_TIMEOUT="${OLLAMA_READY_TIMEOUT:-45}"

ollama_http_ready() {
    curl --noproxy '*' -fsS --connect-timeout 1 --max-time 2 \
        "${OLLAMA_BASE_URL%/}/api/tags" >/dev/null 2>&1
}

if ! ollama_http_ready; then
    if ! pgrep -x "ollama" >/dev/null; then
        echo "Starting Ollama..."
        nohup ollama serve >/tmp/ollama.log 2>&1 &
    fi

    if ! [[ "$OLLAMA_READY_TIMEOUT" =~ ^[0-9]{1,3}$ ]] ||
       (( OLLAMA_READY_TIMEOUT < 1 || OLLAMA_READY_TIMEOUT > 300 )); then
        OLLAMA_READY_TIMEOUT=45
    fi
    echo "Waiting for Ollama API at ${OLLAMA_BASE_URL} (timeout ${OLLAMA_READY_TIMEOUT}s)..."
    ollama_ready=0
    for ((ollama_second = 0; ollama_second < OLLAMA_READY_TIMEOUT; ollama_second++)); do
        if ollama_http_ready; then
            ollama_ready=1
            break
        fi
        sleep 1
    done
    if [ "$ollama_ready" -ne 1 ]; then
        echo "ERROR: Ollama API did not become ready at ${OLLAMA_BASE_URL}; see /tmp/ollama.log." >&2
        exit 1
    fi
fi
echo "Ollama API is ready at ${OLLAMA_BASE_URL}."

# Ensure PostgreSQL is available for LiteLLM UI/auth
if command -v pg_isready >/dev/null 2>&1; then
    if ! pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1; then
        if command -v service >/dev/null 2>&1; then
            sudo -n service postgresql start >/dev/null 2>&1 || true
        fi
        if command -v pg_ctlcluster >/dev/null 2>&1; then
            sudo -n pg_ctlcluster 12 main start >/dev/null 2>&1 || true
        fi
        sleep 3
    fi

    if pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1; then
        if ! sudo -n -u postgres psql -Atqc \
            "SELECT 1 FROM pg_roles WHERE rolname='litellm'" 2>/dev/null | grep -qx '1'; then
            echo "Creating PostgreSQL user/database for LiteLLM..."
            sudo -n -u postgres psql \
                -c "CREATE USER litellm WITH PASSWORD 'litellm';" \
                >/dev/null 2>&1 || true
            sudo -n -u postgres psql \
                -c "CREATE DATABASE litellm OWNER litellm;" \
                >/dev/null 2>&1 || true
        fi
    fi
fi

# Ensure LiteLLM is running
if ! pgrep -f '[l]itellm' >/dev/null; then
    if [ -f "$HOME/litellm/.env" ]; then
        set -a
        . "$HOME/litellm/.env"
        set +a
    fi
    echo "Starting LiteLLM..."
    if [ -x /home/marzec/.local/bin/litellm ]; then
        nohup python3.12 /home/marzec/.local/bin/litellm \
            --config "$HOME/litellm/config.yaml" \
            --port 4000 \
            >/tmp/litellm.log 2>&1 &
    else
        nohup litellm \
            --config "$HOME/litellm/config.yaml" \
            --port 4000 \
            >/tmp/litellm.log 2>&1 &
    fi
    sleep 3
fi


# Start Caracal RAG after LiteLLM. Only attach credentials to a service that
# this launcher verifies it owns; never kill processes by a fuzzy name.
CARACAL_HOME="${CARACAL_HOME:-$HOME/.caracal}"
export CARACAL_HOME
CARACAL_CLI="$CARACAL_HOME/bin/caracal-rag"
CARACAL_RUN_DIR="$CARACAL_HOME/run"
CARACAL_PID_FILE="$CARACAL_RUN_DIR/mcp.pid"
CARACAL_LOG="/tmp/caracal-mcp.log"

caracal_http_ready() {
    local url="$1" status
    status="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 2 "$url" 2>/dev/null || true)"
    [[ "$status" =~ ^[1-4][0-9][0-9]$ ]]
}

caracal_pid_matches() {
    local pid="$1" command_line
    [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]] || return 1
    command_line="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
    [[ "$command_line" == *"caracal-rag mcp --transport http"* &&
       "$command_line" == *"--port $CARACAL_MCP_PORT"* &&
       "$command_line" == *"--path $CARACAL_MCP_PATH"* ]]
}

# Load the Caracal bearer token from the single Caracal provider.
# The provider (~/.caracal/env.sh) reads secrets.yaml, validates the token,
# and (optionally) resolves the live loopback URL. aicode sources it without
# CARACAL_RESOLVE_LIVE=1 because ensure_caracal_mcp manages the live URL and
# Caracal service startup itself.
# shellcheck source=~/.caracal/env.sh
. "$CARACAL_HOME/env.sh"

ensure_caracal_mcp() {
    # Token is already loaded and validated by the Caracal provider
    # (~/.caracal/env.sh). The provider exports CARACAL_ACCESS_TOKEN.
    # aicode sources it without CARACAL_RESOLVE_LIVE=1 because this function
    # manages the live URL and Caracal service startup itself.
    if [ -z "${CARACAL_ACCESS_TOKEN:-}" ]; then
        echo "ERROR: Caracal access token is unavailable; no agent runtime will start." >&2
        return 1
    fi

    # An explicitly configured URL opts into an externally managed endpoint.
    # It still must be reachable here and pass real authenticated probes below.
    if [ -n "${CARACAL_MCP_URL:-}" ] &&
       [[ "${CARACAL_MCP_URL:-}" != "http://127.0.0.1:0/mcp" ]]; then
        case "$CARACAL_MCP_URL" in
            http://*|https://*) ;;
            *)
                echo "ERROR: CARACAL_MCP_URL must be an absolute HTTP(S) URL." >&2
                return 1
                ;;
        esac
        if [[ "$CARACAL_MCP_URL" == *[$'\r\n\"']* ]]; then
            echo "ERROR: CARACAL_MCP_URL contains unsupported control/quote characters." >&2
            return 1
        fi
        if ! caracal_http_ready "$CARACAL_MCP_URL"; then
            echo "ERROR: explicitly configured Caracal MCP endpoint is not reachable." >&2
            return 1
        fi
        export CARACAL_MCP_REQUIRED=1
        echo "Using the explicitly configured, reachable Caracal MCP endpoint."
        return 0
    fi

    # Keep the configuration visibly disconnected until local startup is proven.
    export CARACAL_MCP_URL="http://127.0.0.1:0/mcp"
    if [ ! -x "$CARACAL_CLI" ]; then
        echo "ERROR: Caracal is not installed at $CARACAL_CLI; refusing to start an agent without MCP." >&2
        return 1
    fi

    local check_output="" mcp_host mcp_port mcp_path mcp_url check_attempt check_succeeded=0
    local check_attempts="${CARACAL_CHECK_ATTEMPTS:-15}"
    if ! [[ "$check_attempts" =~ ^[0-9]{1,3}$ ]] ||
       (( check_attempts < 1 || check_attempts > 60 )); then
        check_attempts=15
    fi
    # Embedding providers and local models can take longer than the Ollama
    # server itself to warm up. Retry the real Caracal embedding probe briefly
    # before failing, preserving the final diagnostic output.
    for ((check_attempt = 1; check_attempt <= check_attempts; check_attempt++)); do
        if check_output="$("$CARACAL_CLI" check 2>&1)"; then
            check_succeeded=1
            break
        fi
        if (( check_attempt < check_attempts )); then
            echo "Caracal embedding healthcheck not ready (attempt $check_attempt/$check_attempts); retrying in 2s..."
            sleep 2
        fi
    done
    if [ "$check_succeeded" -ne 1 ]; then
        echo "ERROR: Caracal healthcheck failed after $check_attempts attempts; MCP was not started." >&2
        printf '%s\n' "$check_output" | tail -n 8 >&2
        return 1
    fi

    mcp_host="$(printf '%s\n' "$check_output" | sed -n 's/.*mcp_host=\([^ ]*\).*/\1/p' | tail -n 1)"
    mcp_port="$(printf '%s\n' "$check_output" | sed -n 's/.*mcp_port=\([^ ]*\).*/\1/p' | tail -n 1)"
    mcp_path="$(printf '%s\n' "$check_output" | sed -n 's/.*mcp_path=\([^ ]*\).*/\1/p' | tail -n 1)"

    if [ "$mcp_host" != "127.0.0.1" ] ||
       ! [[ "$mcp_port" =~ ^[0-9]{1,5}$ ]] ||
       (( mcp_port < 1 || mcp_port > 65535 )) ||
       ! [[ "$mcp_path" =~ ^/[A-Za-z0-9/_-]+$ ]]; then
        echo "ERROR: Caracal must use loopback HTTP with a valid port and absolute MCP path." >&2
        return 1
    fi

    CARACAL_MCP_PORT="$mcp_port"
    CARACAL_MCP_PATH="$mcp_path"
    mcp_url="http://127.0.0.1:$mcp_port$mcp_path"

    if [ -L "$CARACAL_RUN_DIR" ] || [ -L "$CARACAL_PID_FILE" ]; then
        echo "ERROR: refusing symlinked Caracal runtime/PID path; inspect $CARACAL_RUN_DIR." >&2
        return 1
    fi
    mkdir -p "$CARACAL_RUN_DIR" || return 1
    chmod 0700 "$CARACAL_RUN_DIR"

    if [ -e "$CARACAL_PID_FILE" ]; then
        if [ ! -f "$CARACAL_PID_FILE" ]; then
            echo "ERROR: refusing unexpected Caracal PID path: $CARACAL_PID_FILE" >&2
            return 1
        fi
        local old_pid
        IFS= read -r old_pid < "$CARACAL_PID_FILE" || old_pid=""
        if caracal_pid_matches "$old_pid"; then
            for _ in $(seq 1 20); do
                if caracal_http_ready "$mcp_url"; then
                    export CARACAL_MCP_URL="$mcp_url" CARACAL_MCP_REQUIRED=1
                    echo "Caracal MCP already running at $mcp_url (PID $old_pid)."
                    return 0
                fi
                if ! kill -0 "$old_pid" 2>/dev/null; then
                    break
                fi
                sleep 1
            done
            echo "ERROR: tracked Caracal MCP process is not responding; see $CARACAL_LOG." >&2
            return 1
        fi
        rm -f -- "$CARACAL_PID_FILE"
    fi

    if caracal_http_ready "$mcp_url"; then
        echo "ERROR: $mcp_url responds but is not owned by a valid Caracal PID file; refusing to attach credentials." >&2
        return 1
    fi

    umask 077
    touch "$CARACAL_LOG" || return 1
    chmod 0600 "$CARACAL_LOG"
    echo "Starting Caracal MCP after LiteLLM..."
    nohup "$CARACAL_CLI" mcp --transport http --host 127.0.0.1 --port "$mcp_port" --path "$mcp_path" \
        </dev/null >>"$CARACAL_LOG" 2>&1 &
    local caracal_pid=$!
    printf '%s\n' "$caracal_pid" > "$CARACAL_PID_FILE" || return 1
    chmod 0600 "$CARACAL_PID_FILE"
    umask 022

    for _ in $(seq 1 20); do
        if caracal_http_ready "$mcp_url" && caracal_pid_matches "$caracal_pid"; then
            export CARACAL_MCP_URL="$mcp_url" CARACAL_MCP_REQUIRED=1
            echo "Caracal MCP ready at $mcp_url."
            return 0
        fi
        if ! kill -0 "$caracal_pid" 2>/dev/null; then
            break
        fi
        sleep 1
    done

    echo "ERROR: Caracal MCP did not become ready; see $CARACAL_LOG. No agent runtime will start." >&2
    if ! kill -0 "$caracal_pid" 2>/dev/null; then
        rm -f -- "$CARACAL_PID_FILE"
    fi
    return 1
}

ensure_todo_mcp_bridge() {
    export TODO_LOCAL_MCP_AVAILABLE=0 TODO_LOCAL_MCP_CONNECTED=0
    unset TODO_LOCAL_MCP_URL

    if [ -z "${TODO_LOCAL_MCP_TOKEN:-}" ]; then
        echo "Todo MCP token is not configured; skipping the optional local endpoint."
        return 0
    fi
    if ! command -v curl >/dev/null 2>&1 ||
       ! declare -F todo_local_mcp_is_wsl >/dev/null 2>&1 ||
       ! declare -F todo_local_mcp_probe_status >/dev/null 2>&1; then
        echo "WARNING: Todo MCP endpoint discovery prerequisites are missing; Todo MCP is disabled for this launch." >&2
        return 0
    fi

    local direct_url="http://127.0.0.1:8765/mcp"
    local direct_status
    direct_status="$(todo_local_mcp_probe_status "$direct_url")"
    if [ "$direct_status" = "401" ]; then
        export TODO_LOCAL_MCP_URL="$direct_url"
        export TODO_LOCAL_MCP_AVAILABLE=1 TODO_LOCAL_MCP_CONNECTED=1
        echo "Todo MCP verified directly at $TODO_LOCAL_MCP_URL."
        return 0
    fi

    # The Windows TCP bridge and its WSL relay are only for WSL NAT mode.
    # Native macOS/Linux (and native Windows shells) should connect to Todo's
    # loopback listener directly; they must not depend on PowerShell or WSL.
    if ! todo_local_mcp_is_wsl; then
        echo "WARNING: Todo Desktop MCP is not reachable at $direct_url (HTTP ${direct_status:-000}); Todo MCP is disabled for this launch." >&2
        echo "Check that Todo Desktop is running, todo.localMcpServer is enabled, and a user session is active." >&2
        return 0
    fi

    if ! command -v powershell.exe >/dev/null 2>&1 || ! command -v wslpath >/dev/null 2>&1 ||
       ! command -v ip >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
        echo "WARNING: WSL/Windows bridge prerequisites are missing; Todo MCP is disabled for this launch." >&2
        return 0
    fi

    local windows_host_ip wsl_client_ip windows_script
    windows_host_ip="$(ip -4 route show default 2>/dev/null | awk '$1 == "default" { for (i = 1; i <= NF; i++) if ($i == "via") { print $(i + 1); exit } }')"
    if ! [[ "$windows_host_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        echo "WARNING: unable to resolve the WSL default-route Windows host IP; Todo MCP is disabled for this launch." >&2
        return 0
    fi
    wsl_client_ip="$(ip -4 route get "$windows_host_ip" 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit } }')"
    if ! [[ "$wsl_client_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        echo "WARNING: unable to resolve the current WSL client IP; Todo MCP is disabled for this launch." >&2
        return 0
    fi
    windows_script="$(wslpath -w "$AICODE_SOURCE_DIR/todo-mcp-bridge.ps1" 2>/dev/null || true)"
    if [ -z "$windows_script" ]; then
        echo "WARNING: unable to resolve the Windows bridge script path; Todo MCP is disabled for this launch." >&2
        return 0
    fi

    echo "Ensuring the Windows Todo MCP bridge is limited to the current WSL address..."
    if ! powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$windows_script" \
        -Action Ensure -BindAddress "$windows_host_ip" -AllowedClientAddress "$wsl_client_ip" -ListenPort 18765; then
        echo "WARNING: Windows Todo MCP bridge could not start; check %LOCALAPPDATA%\\GlobalSkills\TodoMcpBridge\\bridge-error.log." >&2
        return 0
    fi

    if ! python3 "$AICODE_SOURCE_DIR/todo-mcp-local-proxy.py" \
        --upstream-host "$windows_host_ip" --upstream-port 18765 --listen-port 8766 \
        --state-dir "$HOME/.cache/globalskills/todo-mcp-bridge"; then
        echo "WARNING: WSL Todo MCP loopback proxy could not start; see ~/.cache/globalskills/todo-mcp-bridge/bridge.log." >&2
        return 0
    fi

    local http_status
    http_status="$(todo_local_mcp_probe_status "http://127.0.0.1:8766/mcp")"

    # Windows can observe a different WSL source address than the one inferred
    # from the route (for example after WSL networking changes). Recover only
    # when the observed address is currently assigned to this WSL instance.
    if [ "$http_status" != "401" ]; then
        local observed_client_ip
        observed_client_ip="$(powershell.exe -NoProfile -NonInteractive -Command '$logFile = Join-Path (Join-Path $env:LOCALAPPDATA "GlobalSkills\TodoMcpBridge") "bridge.log"; if (Test-Path -LiteralPath $logFile) { $match = Get-Content -LiteralPath $logFile | Select-String -Pattern "Rejected connection from (?<ip>[0-9]{1,3}(?:\.[0-9]{1,3}){3}); expected WSL source" | Select-Object -Last 1; if ($match) { $match.Matches[0].Groups["ip"].Value } }' 2>/dev/null | tr -d '\r' | tail -n 1)"

        if [[ "$observed_client_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] &&
           ip -o -4 addr show 2>/dev/null | awk '{ split($4, address, "/"); print address[1] }' | grep -Fxq "$observed_client_ip"; then
            echo "Windows observed WSL source $observed_client_ip; synchronizing the bridge allowlist and retrying..."
            if powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$windows_script" -Action Ensure -BindAddress "$windows_host_ip" -AllowedClientAddress "$observed_client_ip" -ListenPort 18765; then
                http_status="$(todo_local_mcp_probe_status "http://127.0.0.1:8766/mcp")"
            else
                echo "WARNING: Windows Todo bridge could not be synchronized to the observed WSL address." >&2
            fi
        elif [ -n "$observed_client_ip" ]; then
            echo "WARNING: Windows Todo bridge observed source $observed_client_ip, which is not assigned to this WSL instance; refusing to expand the allowlist." >&2
        fi
    fi

    if [ "$http_status" = "401" ]; then
        export TODO_LOCAL_MCP_URL="http://127.0.0.1:8766/mcp"
        export TODO_LOCAL_MCP_AVAILABLE=1 TODO_LOCAL_MCP_CONNECTED=1
        echo "Todo MCP bridge verified at $TODO_LOCAL_MCP_URL; unauthenticated access is rejected."
    else
        echo "WARNING: Todo MCP bridge did not return the expected HTTP 401 challenge (status $http_status). Todo MCP is disabled for this launch." >&2
        powershell.exe -NoProfile -NonInteractive -Command '$root = Join-Path $env:LOCALAPPDATA "GlobalSkills\TodoMcpBridge"; $stateFile = Join-Path $root "bridge.json"; $logFile = Join-Path $root "bridge.log"; if (Test-Path -LiteralPath $stateFile) { $state = Get-Content -LiteralPath $stateFile -Raw | ConvertFrom-Json; Write-Output ("Windows bridge expected WSL source: " + $state.allowedClientAddress) }; if (Test-Path -LiteralPath $logFile) { Get-Content -LiteralPath $logFile -Tail 12 }' 2>/dev/null | tr -d '\r' | sed 's/^/  Windows bridge: /' >&2
        echo "Check that Todo Desktop is running with todo.localMcpServer enabled." >&2
    fi
    return 0
}

ensure_opencode_caracal_config() {
    OPENCODE_CONFIG="${OPENCODE_CONFIG:-$HOME/.config/opencode/opencode.json}"
    export OPENCODE_CONFIG
    local config_dir tmp config_input
    config_dir="$(dirname -- "$OPENCODE_CONFIG")"
    mkdir -p "$config_dir" || return 1
    if [ -L "$OPENCODE_CONFIG" ]; then
        echo "ERROR: refusing symlinked OpenCode config path: $OPENCODE_CONFIG" >&2
        return 1
    fi
    tmp="$(mktemp "$config_dir/.opencode-caracal.XXXXXX")" || return 1
    if [ -f "$OPENCODE_CONFIG" ]; then
        config_input="$OPENCODE_CONFIG"
    else
        config_input="/dev/null"
    fi
    # The jq program is written to a file with a quoted heredoc so that literal
    # apostrophes in comments (OpenCode's, OpenClaw's) never terminate the
    # surrounding single-quoted program argument. An inline multi-line single
    # quote breaks the program into many arguments that jq treats as filenames.
    local jq_program
    jq_program="$(mktemp "$config_dir/.opencode-caracal-jq.XXXXXX")" || return 1
    cat >"$jq_program" <<'JQ'
def as_permission_object:
  if type == "object" then .
  elif type == "string" then {"*": .}
  else {}
  end;

def strip_todo_legacy_tools:
  if type == "object" then
    del(
      ."todo-local_*",
      ."todo-local_ping",
      ."todo-local_list_tasks",
      ."todo-local_list_scheduled_tasks",
      ."todo-local_get_task",
      ."todo-local_list_shareable_users",
      ."todo-local_create_task",
      ."todo-local_create_tasks",
      ."todo-local_create_task_tree",
      ."todo-local_update_task",
      ."todo-local_mark_tasks_done",
      ."todo-local_mark_tasks_to_do",
      ."todo-local_reorder_tasks",
      ."todo-local_schedule_tasks",
      ."todo-local_copy_task",
      ."todo-local_remove_task",
      ."todo-local_leave_shared_task"
    )
  else .
  end;

def todo_mcp_permission_rules($read_enabled):
  {
    "todo-local_*": "deny",
    "todo-local_ping": (if $read_enabled then "allow" else "deny" end),
    "todo-local_list_tasks": (if $read_enabled then "allow" else "deny" end),
    "todo-local_list_scheduled_tasks": (if $read_enabled then "allow" else "deny" end),
    "todo-local_get_task": (if $read_enabled then "allow" else "deny" end),
    "todo-local_list_shareable_users": (if $read_enabled then "allow" else "deny" end),
    "todo-local_create_task": "deny",
    "todo-local_create_tasks": "deny",
    "todo-local_create_task_tree": "deny",
    "todo-local_update_task": "deny",
    "todo-local_mark_tasks_done": "deny",
    "todo-local_mark_tasks_to_do": "deny",
    "todo-local_reorder_tasks": "deny",
    "todo-local_schedule_tasks": "deny",
    "todo-local_copy_task": "deny",
    "todo-local_remove_task": "deny",
    "todo-local_leave_shared_task": "deny"
  };

        (.[0] // {})
        # OpenCode's MCP schema is .mcp[server-name], unlike OpenClaw's
        # separate .mcp.servers schema.
        | .mcp = (
            (.mcp // {}) | if type == "object" then . else {} end
            | . + {
                "caracal-rag": {
                    type: "remote",
                    url: "{env:CARACAL_MCP_URL}",
                    oauth: false,
                    enabled: true,
                    headers: {Authorization: "Bearer {env:CARACAL_ACCESS_TOKEN}"}
                }
            }
          )
        | .tools = ((.tools // {}) | if type == "object" then . else {} end | . + {"caracal-rag_*": true})
        | .agent = (
            (.agent // {})
            | if type == "object" then
                with_entries(
                  if .key == "chat" then .
                  else .value.tools = ((.value.tools // {}) | if type == "object" then . else {} end | . + {"caracal-rag_*": true})
                  end
                )
              else {}
              end
          )
        | if (env.TODO_LOCAL_MCP_AVAILABLE // "0") == "1" then
            .mcp = (
                (.mcp // {}) | if type == "object" then . else {} end
                | . + {
                    "todo-local": {
                        type: "remote",
                        url: "{env:TODO_LOCAL_MCP_URL}",
                        oauth: false,
                        enabled: true,
                        headers: {Authorization: "Bearer {env:TODO_LOCAL_MCP_TOKEN}"}
                    }
                  }
              )
          else
            .mcp = ((.mcp // {}) | if type == "object" then . else {} end | del(."todo-local"))
          end
        | .tools = ((.tools // {}) | strip_todo_legacy_tools)
        | .permission = (
            (.permission // {}) | as_permission_object
            | . + todo_mcp_permission_rules((env.TODO_LOCAL_MCP_AVAILABLE // "0") == "1")
          )
        | .agent = (
            (.agent // {})
            | if type == "object" then
                with_entries(
                  .key as $agent_name
                  | .value.tools = ((.value.tools // {}) | strip_todo_legacy_tools)
                  | .value.permission = (
                      (.value.permission // {}) | as_permission_object
                      | . + todo_mcp_permission_rules(
                          (env.TODO_LOCAL_MCP_AVAILABLE // "0") == "1" and $agent_name != "chat"
                        )
                    )
                )
              else {}
              end
          )
JQ
    if ! jq -s -f "$jq_program" "$config_input" > "$tmp"; then
        rm -f -- "$jq_program"
        rm -f -- "$tmp"
        echo "ERROR: unable to merge Caracal MCP into the OpenCode config." >&2
        return 1
    fi
    rm -f -- "$jq_program"
    if [ -f "$OPENCODE_CONFIG" ] && cmp -s "$tmp" "$OPENCODE_CONFIG"; then
        rm -f -- "$tmp"
    else
        if [ -f "$OPENCODE_CONFIG" ]; then
            cp -p -- "$OPENCODE_CONFIG" "$OPENCODE_CONFIG.bak.$(date +%Y%m%d-%H%M%S)" || { rm -f -- "$tmp"; return 1; }
            chmod --reference="$OPENCODE_CONFIG" "$tmp" 2>/dev/null || true
        else
            chmod 0600 "$tmp"
        fi
        mv -- "$tmp" "$OPENCODE_CONFIG" || { rm -f -- "$tmp"; return 1; }
        echo "OpenCode Caracal MCP config updated (backup retained when replacing an existing file)."
    fi

    local mcp_output opencode_cli
    if [ -n "${OPENCODE_BIN:-}" ] && [ -x "$OPENCODE_BIN" ]; then
        opencode_cli="$OPENCODE_BIN"
    else
        opencode_cli="$(command -v opencode 2>/dev/null || true)"
    fi
    if [ -z "$opencode_cli" ] || [ ! -x "$opencode_cli" ]; then
        echo "ERROR: OpenCode CLI is not executable; cannot verify Caracal MCP." >&2
        return 1
    fi
    if ! mcp_output="$(timeout 45 "$opencode_cli" mcp list 2>&1)" ||
       ! printf '%s\n' "$mcp_output" | grep -Eiq 'caracal-rag[[:space:]].*connected|connected.*caracal-rag'; then
        echo "ERROR: OpenCode does not report caracal-rag as connected; see the output of 'opencode mcp list'. No agent runtime will start." >&2
        return 1
    fi
    echo "OpenCode reports caracal-rag connected."
    if [ "$TODO_LOCAL_MCP_CONNECTED" = "1" ] &&
       ! printf '%s\n' "$mcp_output" | grep -Eiq 'todo-local[[:space:]].*connected|connected.*todo-local'; then
        echo "ERROR: the verified Todo MCP bridge is not connected in OpenCode; no OpenCode session will start." >&2
        return 1
    fi
    if [ "$TODO_LOCAL_MCP_AVAILABLE" = "1" ]; then
        echo "OpenCode reports todo-local connected."
    fi
}

configure_openclaw_opencode_acp() {
    local snapshot snapshot_config base_hash patch params verified
    local wrapper="$HOME/.globalskills/aicode/opencode-acp-caracal.sh"

    if [ ! -r "$wrapper" ]; then
        echo "ERROR: OpenCode ACP Caracal wrapper is missing: $wrapper" >&2
        return 1
    fi

    # The helper captures the CLI exit status before parsing stdout, strips
    # only the known advisory prefix, and validates the config plus raw file hash.
    if ! snapshot="$(openclaw_config_get_snapshot)"; then
        echo "ERROR: OpenClaw config snapshot is invalid or missing its config/file hash." >&2
        return 1
    fi
    base_hash="$(printf '%s\n' "$snapshot" | openclaw_config_snapshot_base_hash)" || {
        echo "ERROR: OpenClaw config snapshot did not include a valid file revision hash." >&2
        return 1
    }
    snapshot_config="$(printf '%s\n' "$snapshot" | openclaw_config_snapshot_config)" || {
        echo "ERROR: OpenClaw config snapshot did not include a valid config object." >&2
        return 1
    }

    # ACPX owns the OpenCode harness process. Configure that one target to use a
    # wrapper which refreshes Caracal credentials and runs opencode mcp list
    # before opencode acp. Do not register a duplicate native OpenClaw MCP:
    # Caracal tools are provided by the OpenCode harness in this deployment.
    if ! printf '%s\n' "$snapshot_config" | jq -e '.plugins.entries.acpx.enabled == true' >/dev/null 2>&1; then
        echo "ERROR: the OpenClaw ACPX plugin must be installed and enabled before configuring the OpenCode harness." >&2
        return 1
    fi

    # OpenClaw ACP must be explicitly enabled and select the installed
    # ACPX backend. allowedAgents alone does not activate ACP.
    # Avoid writing the Gateway config on every launch once all fields match.
    if printf '%s\n' "$snapshot_config" | jq -e --arg wrapper "$wrapper" '
      (.acp.enabled == true)
      and (.acp.backend == "acpx")
      and (.plugins.entries.acpx.enabled == true)
      and (.plugins.entries.acpx.config.probeAgent == "opencode")
      and (.plugins.entries.acpx.config.agents.opencode.command == "bash")
      and (.plugins.entries.acpx.config.agents.opencode.args == [$wrapper, "acp"])
      and ((.acp.allowedAgents | type) == "array")
      and ((.acp.allowedAgents | index("opencode")) != null)
    ' >/dev/null 2>&1; then
        echo "OpenClaw ACP OpenCode harness already uses the Caracal-verifying wrapper."
        return 0
    fi

    patch="$(printf '%s\n' "$snapshot_config" | jq -c --arg wrapper "$wrapper" '
      . as $cfg
      | {
          plugins: {
            entries: {
              acpx: {
                config: {
                  probeAgent: "opencode",
                  agents: {
                    opencode: {
                      command: "bash",
                      args: [$wrapper, "acp"]
                    }
                  }
                }
              }
            }
          }
        }
        + {
            acp: (
              ($cfg.acp // {})
              | .enabled = true
              | .backend = "acpx"
              | .allowedAgents = (
                  (if (.allowedAgents | type) == "array" then .allowedAgents else [] end)
                  + ["opencode"]
                  | unique
                )
            )
          }
    ')" || {
        echo "ERROR: unable to prepare OpenCode ACP harness configuration." >&2
        return 1
    }
    params="$(jq -cn --arg raw "$patch" --arg baseHash "$base_hash" \
        '{raw:$raw,baseHash:$baseHash,note:"Route OpenClaw ACP OpenCode through the Caracal-verified wrapper"}')" || return 1
    if ! openclaw gateway call config.patch --params "$params" >/dev/null 2>&1; then
        echo "ERROR: OpenClaw rejected the OpenCode ACP harness configuration." >&2
        return 1
    fi

    if ! verified="$(openclaw_config_get_snapshot)" ||
       ! printf '%s\n' "$verified" | jq -e --arg wrapper "$wrapper" '
         (.config.acp.enabled == true)
         and (.config.acp.backend == "acpx")
         and (.config.plugins.entries.acpx.enabled == true)
         and (.config.plugins.entries.acpx.config.probeAgent == "opencode")
         and (.config.plugins.entries.acpx.config.agents.opencode.command == "bash")
         and (.config.plugins.entries.acpx.config.agents.opencode.args == [$wrapper, "acp"])
         and ((.config.acp.allowedAgents | type) == "array")
         and ((.config.acp.allowedAgents | index("opencode")) != null)
       ' >/dev/null 2>&1; then
        echo "ERROR: OpenClaw did not retain the expected OpenCode ACP wrapper configuration." >&2
        return 1
    fi

    echo "OpenClaw ACP OpenCode harness configured with the Caracal-verifying wrapper."
}

# Chroma is a separate local database service; Caracal's check needs it reachable.
# An explicit CARACAL_MCP_URL means the MCP endpoint is externally managed, so
# do not start a local Chroma instance for that mode.
if [ -z "${CARACAL_MCP_URL:-}" ]; then
    if [ -r "$AICODE_SOURCE_DIR/chroma-lifecycle.sh" ]; then
        # shellcheck source=aicode/chroma-lifecycle.sh
        . "$AICODE_SOURCE_DIR/chroma-lifecycle.sh"
        ensure_chroma_server "$CARACAL_HOME" || true
    else
        echo "WARNING: Chroma lifecycle helper is missing next to aicode; automatic Chroma startup is skipped."
    fi
fi

if ! ensure_caracal_mcp; then
    exit 1
fi
ensure_todo_mcp_bridge
if ! ensure_opencode_caracal_config; then
    exit 1
fi
if [ "$AGENT_RUNTIME" = "openclaw" ]; then
    # The ACP wrapper loads current Caracal credentials directly when each
    # OpenCode harness starts, so no Gateway restart is needed just to refresh them.
    GATEWAY_PORT="${OPENCLAW_GATEWAY_PORT:-18789}"
    gateway_responding() {
        curl -fsS --max-time 2 \
            "http://127.0.0.1:${GATEWAY_PORT}" \
            >/dev/null 2>&1
    }

    if ! gateway_responding; then
        nohup openclaw gateway \
            --force \
            --allow-unconfigured \
            --port "$GATEWAY_PORT" \
            >/tmp/openclaw-gateway.log 2>&1 &

        echo "Waiting for OpenClaw Gateway to become ready on 127.0.0.1:${GATEWAY_PORT}..."
        ready=0
        for _ in $(seq 1 20); do
            if gateway_responding; then
                ready=1
                break
            fi
            sleep 1
        done

        if [ "$ready" -eq 1 ]; then
            echo "OpenClaw Gateway is up on http://127.0.0.1:${GATEWAY_PORT}"
        else
            echo "ERROR: OpenClaw Gateway did not become ready; see /tmp/openclaw-gateway.log" >&2
            exit 1
        fi
    else
        echo "OpenClaw Gateway is already running on http://127.0.0.1:${GATEWAY_PORT}"
    fi

    if ! configure_openclaw_opencode_acp; then
        exit 1
    fi
else
    # In direct OpenCode mode, ACPX is irrelevant: Manul starts OpenCode
    # through its own adapter and must not touch the OpenClaw Gateway.
    echo "OpenClaw Gateway/ACPX skipped (Manul agentRuntime=$AGENT_RUNTIME)."
fi

# Ensure Manul GitHub bot daemon is running.
# Never let a broken/hung daemon block OpenCode startup.
# The canonical installer/repairer is authoritative for ~/.manul runtime state.
MANUL_INSTALLER="$HOME/.globalskills/skills/manul-github-bot/install-manul.sh"
MANUL_REPAIRER="$HOME/.globalskills/skills/manul-github-bot/repair-manul-runtime.sh"
MANUL_RUNTIME="$MANUL_DIR"
MANUL_DB="$MANUL_RUNTIME/manul.db"
MANUL_SCRIPT="$MANUL_RUNTIME/manul-daemon.sh"
MANUL_LOG="/tmp/manul-daemon.log"
MANUL_ENV_HELPER="$HOME/.globalskills/skills/manul-github-bot/manul-env.sh"

# Refresh the Caracal endpoint/token pair before any installer, repairer or
# existing daemon can load a stale ~/.manul/.env. This update is atomic and
# preserves unrelated operator-owned values.
if [ ! -r "$MANUL_ENV_HELPER" ]; then
    echo "ERROR: Manul environment helper is missing: $MANUL_ENV_HELPER" >&2
    exit 1
fi
# shellcheck source=skills/manul-github-bot/manul-env.sh
source "$MANUL_ENV_HELPER" || {
    echo "ERROR: could not load the Manul environment helper." >&2
    exit 1
}
if ! manul_env_bootstrap "$MANUL_RUNTIME" >/dev/null; then
    echo "ERROR: could not persist the current Caracal MCP endpoint/token for Manul." >&2
    exit 1
fi

# Prepare Manul without ever replacing existing task state implicitly.
# repair-manul-runtime.sh restores a missing/corrupt DB from a known backup.
# Only a truly fresh runtime with no recoverable DB may use --init-state.
if [ -x "$MANUL_REPAIRER" ]; then
    if ! "$MANUL_REPAIRER" >/dev/null 2>&1; then
        if [ ! -f "$MANUL_DB" ] && [ -x "$MANUL_INSTALLER" ]; then
            if ! "$MANUL_INSTALLER" --init-state >/dev/null 2>&1; then
                echo "WARNING: Manul fresh initialization failed; continuing with OpenCode."
            fi
        else
            echo "WARNING: Manul runtime repair failed; continuing with OpenCode."
        fi
    fi
elif [ -x "$MANUL_INSTALLER" ]; then
    if [ ! -f "$MANUL_DB" ]; then
        if ! "$MANUL_INSTALLER" --init-state >/dev/null 2>&1; then
            echo "WARNING: Manul fresh initialization failed; continuing with OpenCode."
        fi
    elif ! "$MANUL_INSTALLER" >/dev/null 2>&1; then
        echo "WARNING: Manul installer validation failed; continuing with OpenCode."
    fi
fi

if [ -x "$MANUL_SCRIPT" ]; then
    if timeout 5 "$MANUL_SCRIPT" start >"$MANUL_LOG" 2>&1; then
        echo "Manul daemon ready."
    else
        rc=$?
        if [ "$rc" -eq 124 ]; then
            echo "WARNING: Manul daemon startup timed out after 5s; continuing with OpenCode."
        else
            echo "WARNING: Manul daemon startup failed (exit $rc); continuing with OpenCode."
        fi
        echo "See $MANUL_LOG for details."
    fi
else
    echo "WARNING: Manul daemon script not found/executable: $MANUL_SCRIPT"
fi

# Launch OpenCode
if [ -n "${OPENCODE_API_KEY:-}" ]; then
    echo "OpenCode Zen API key detected; all Zen models available."
else
    echo "No OPENCODE_API_KEY detected; Zen models unavailable."
fi

echo "Local model via LiteLLM: litellm/local-coder (Gemma 4 12B)"
if [ "$AGENT_RUNTIME" = "openclaw" ]; then
    echo "OpenClaw Gateway: http://127.0.0.1:${GATEWAY_PORT} (openclaw dashboard)"
else
    echo "OpenClaw Gateway not required (Manul agentRuntime=$AGENT_RUNTIME)."
fi

type -p opencode >/dev/null 2>&1 || {
    echo "ERROR: opencode command not found in PATH." >&2
    exit 127
}

exec opencode "$@" --auto
